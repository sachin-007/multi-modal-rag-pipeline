# Required: Ollama Cloud API key from https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_api_key_here

# OpenAI-compatible base URL for Ollama Cloud (chat only)
OPENAI_BASE_URL=https://ollama.com/v1

# Chat model on Ollama Cloud (text-only — do not send image_url parts)
LLM_MODEL=gpt-oss:120b
# Figures stay in chunk metadata; answers/summaries use text + tables only.

# Embeddings: Ollama Cloud does NOT expose /v1/embeddings.
# Use local sentence-transformers (default) on CPU / HF Spaces.
EMBED_BACKEND=local
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: local Ollama with an embedding model pulled
# EMBED_BACKEND=ollama
# EMBED_MODEL=nomic-embed-text
# OPENAI_BASE_URL=http://localhost:11434/v1

# Hybrid retrieval (multi-query + BM25 + vector + RRF + rerank)
MULTI_QUERY_N=3
BM25_K=10
VECTOR_K=10
RRF_K=60
RRF_TOP_N=30
# Final chunks sent to the LLM (also used if RETRIEVAL_K is set)
RERANK_TOP_N=5
RETRIEVAL_K=5

# Rerank: cohere (default) or local. Never commit a real RERANK_API_KEY.
RERANK_BACKEND=cohere
RERANK_MODEL=rerank-english-v3.0
RERANK_API_KEY=
# Automatic fallback when Cohere fails (429, billing, timeout, missing key, …)
RERANK_FALLBACK_BACKEND=local
RERANK_FALLBACK_MODEL=BAAI/bge-reranker-base

# Force local only:
# RERANK_BACKEND=local
# RERANK_MODEL=BAAI/bge-reranker-base

TABLE_PROMPT_MAX_CHARS=4000

# Optional paths (defaults work for local + Docker)
# CHROMA_DIR=data/chroma_db
# UPLOAD_DIR=data/uploads
# BM25_PATH=data/bm25_docs.pkl
# DEMO_PDF_PATH=docs/demo_pdf.pdf
# DEMO_PDF_URL=   # optional fallback download if local file is missing
# PARTITION_STRATEGY=hi_res
